{
  "id": "root",
  "cloned_from": {
    "name": "main",
    "version": "0.1.13"
  },
  "type": "row",
  "children": [
    {
      "id": "sidebar",
      "type": "column",
      "children": [
        {
          "id": "tree",
          "type": "block",
          "content": {
            "mod": "tree"
          },
          "window_drag": true
        }
      ],
      "size": {
        "px": 288
      },
      "min": 44,
      "max": 480,
      "background": "chrome",
      "resizable": false
    },
    {
      "id": "work",
      "type": "column",
      "children": [
        {
          "id": "tabs",
          "type": "block",
          "content": {
            "mod": "status-tabs"
          },
          "size": {
            "px": 42
          },
          "window_drag": true
        },
        {
          "id": "work-body",
          "type": "row",
          "children": [
            {
              "id": "main",
              "type": "block",
              "content": {
                "tab": "active",
                "pane": {
                  "header": {
                    "content": {
                      "mod": "callsign-pane"
                    },
                    "reveal": "always",
                    "height": 30,
                    "position": "top"
                  },
                  "background": "background",
                  "radius": 0,
                  "gap": 8,
                  "lone": true,
                  "border": {
                    "width": 1,
                    "color": "background"
                  },
                  "focus": {
                    "width": 1,
                    "color": "accent"
                  }
                }
              }
            },
            {
              "id": "panel",
              "type": "column",
              "children": [
                {
                  "id": "panel-body",
                  "type": "stack",
                  "children": [
                    {
                      "id": "files",
                      "type": "block",
                      "content": {
                        "mod": "files-nav"
                      }
                    },
                    {
                      "id": "ticket-status",
                      "type": "block",
                      "content": {
                        "mod": "status-panel",
                        "props": {
                          "panel": "ticket"
                        }
                      }
                    },
                    {
                      "id": "pr-status",
                      "type": "block",
                      "content": {
                        "mod": "status-panel",
                        "props": {
                          "panel": "pr"
                        }
                      }
                    }
                  ],
                  "active": "files"
                }
              ],
              "size": {
                "px": 368
              },
              "min": 280,
              "max": 900,
              "hidden": true
            }
          ],
          "padding": 8,
          "gap": 8
        },
        {
          "id": "status",
          "type": "block",
          "content": {
            "mod": "workspace-status"
          },
          "size": {
            "px": 28
          }
        },
        {
          "id": "callsigns",
          "type": "block",
          "size": {
            "px": 0
          },
          "content": {
            "mod": "callsigns"
          }
        },
        {
          "id": "resume",
          "type": "block",
          "size": {
            "px": 0
          },
          "content": {
            "mod": "resume"
          }
        },
        {
          "id": "smart-split",
          "type": "block",
          "size": {
            "px": 0
          },
          "content": {
            "mod": "smart-split"
          }
        },
        {
          "id": "close-others",
          "type": "block",
          "size": {
            "px": 0
          },
          "content": {
            "mod": "close-others"
          }
        },
        {
          "id": "toggle-split",
          "type": "block",
          "size": {
            "px": 0
          },
          "content": {
            "mod": "toggle-split"
          }
        }
      ],
      "resizable": false
    }
  ],
  "background": "canvas",
  "terminal_padding": [
    14,
    12
  ],
  "titlebar": "none",
  "traffic_lights": [
    12,
    16
  ]
}
