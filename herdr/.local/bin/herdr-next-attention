#!/bin/sh

set -eu

notify() {
  herdr notification show "next attention" --body "$1" --sound none >/dev/null || true
}

die() {
  notify "$1"
  exit 1
}

# Agents in a stable workspace-then-pane order, rotated to start after the
# focused one, so repeated presses walk the queue instead of bouncing between the
# same two panes. Tiers run blocked, done, then idle: an agent holding up an
# approval comes before one that just finished, which comes before one that has
# been sitting there. Every tier still cycles in the same order. `unknown` is
# left out because an agent Herdr cannot classify may well be mid-task.
state="$(herdr workspace list && herdr agent list)" ||
  die "herdr is not responding"

target="$(
  printf '%s\n' "$state" |
  jq -rs '
    (.[0].result.workspaces | map(.workspace_id)) as $order
    | [
        .[1].result.agents[]
        | . as $agent
        | {
            pane_id,
            focused,
            status: .agent_status,
            workspace: ($order | index($agent.workspace_id) // ($order | length)),
            pane: ([.pane_id | scan("[0-9]+$")][0] // "0" | tonumber)
          }
      ]
    | sort_by([.workspace, .pane]) as $agents
    | ($agents | map(.focused) | index(true)) as $at
    | (if $at == null then $agents else $agents[$at + 1:] + $agents[:$at] end) as $rotated
    | first(
        ("blocked", "done", "idle") as $tier
        | $rotated[]
        | select(.status == $tier)
      )
    | .pane_id
  '
)" || die "could not read the agent list"

if [ -z "$target" ]; then
  notify "no other agent is waiting"
  exit 0
fi

herdr agent focus "$target" >/dev/null || die "could not focus $target"
