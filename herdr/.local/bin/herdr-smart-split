#!/bin/sh
# smart split: one key, direction picked from the focused pane's geometry.
# wide pane splits right, tall pane splits down. terminal cells run about 2:1
# tall:wide, so width needs twice the rows to read side by side. when the
# picked half would be a sliver, the other axis wins instead.
set -eu

die() {
  herdr notification show "split" --body "$1" --sound none >/dev/null 2>&1 || true
  exit 1
}

panes="$(herdr pane list)" || die "herdr is not responding"

# Prefer the calling pane when this runs from inside one, and fall back to the
# UI-focused pane, which is what a keybinding gets.
pane="$(
  printf '%s' "$panes" |
  jq -r --arg env "${HERDR_PANE_ID:-}" '
    .result.panes as $panes
    | ([$panes[] | select(.pane_id == $env)] + [$panes[] | select(.focused == true)])[0] // empty
    | [.pane_id, .cwd] | @tsv
  '
)"

[ -n "$pane" ] || die "no focused pane"

pane_id="$(printf '%s\n' "$pane" | cut -f1)"
cwd="$(printf '%s\n' "$pane" | cut -f2)"

rect="$(
  herdr pane layout --pane "$pane_id" |
  jq -r --arg p "$pane_id" '
    .result.layout.panes[] | select(.pane_id == $p) | [.rect.width, .rect.height] | @tsv
  '
)" || die "could not read the layout for $pane_id"

width="$(printf '%s\n' "$rect" | cut -f1)"
height="$(printf '%s\n' "$rect" | cut -f2)"
[ -n "$width" ] && [ -n "$height" ] || die "no layout rect for $pane_id"

if [ "$width" -ge "$((height * 2))" ]; then
  direction="right"
else
  direction="down"
fi

case "$direction" in
  right) [ "$((width / 2))" -lt 20 ] && direction="down" ;;
  down) [ "$((height / 2))" -lt 6 ] && direction="right" ;;
esac

herdr pane split "$pane_id" --direction "$direction" --ratio 0.5 --cwd "$cwd" --focus >/dev/null ||
  die "could not split $pane_id"
