#!/bin/sh

set -eu

die() {
  herdr notification show "edit" --body "$1" --sound none >/dev/null 2>&1 || true
  exit 1
}

panes="$(herdr pane list)" || die "herdr is not responding"

pane="$(
  printf '%s' "$panes" |
  jq -r '
    .result.panes as $panes
    | ([$panes[] | select(.focused == true)])[0] // empty
    | . as $p
    | [.pane_id, .cwd, ([$panes[] | select(.tab_id == $p.tab_id)] | length)]
    | @tsv
  '
)"

[ -n "$pane" ] || die "no focused pane"

pane_id="$(printf '%s\n' "$pane" | cut -f1)"
cwd="$(printf '%s\n' "$pane" | cut -f2)"
panes_in_tab="$(printf '%s\n' "$pane" | cut -f3)"

# same rule as herdr-sidetrack: side by side when alone, stacked once sharing.
if [ "$panes_in_tab" -le 1 ]; then
  direction="right"
else
  direction="down"
fi

created="$(herdr pane split "$pane_id" --direction "$direction" --ratio 0.5 --cwd "$cwd" --focus)" ||
  die "could not split $pane_id"
new_pane="$(printf '%s' "$created" | jq -r '.result.pane.pane_id')"

[ -n "$new_pane" ] && [ "$new_pane" != "null" ] || die "could not split $pane_id"

name="editor"
suffix=2
while herdr pane list 2>/dev/null | jq -e --arg n "$name" '.result.panes[]? | select((.label // "") == $n)' >/dev/null 2>&1; do
  name="editor-$suffix"
  suffix=$((suffix + 1))
  [ "$suffix" -le 100 ] || break
done
herdr pane rename "$new_pane" "$name" >/dev/null 2>&1 || true

# exec so quitting nvim closes the pane instead of dropping to a shell.
herdr pane run "$new_pane" "exec nvim" >/dev/null || die "could not start nvim in $new_pane"
