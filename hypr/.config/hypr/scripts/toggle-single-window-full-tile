#!/bin/bash

set -euo pipefail

state_dir="$HOME/.local/state/omarchy/single-window-full-tile"
workspaces="$state_dir/workspaces"
rule_file="$HOME/.local/state/omarchy/toggles/hypr/single-window-full-tile.conf"

mkdir -p "$state_dir" "$(dirname "$rule_file")"

active_workspace() {
  hyprctl -j activeworkspace | jq -r '.id | tostring'
}

workspace_enabled() {
  local workspace="$1"
  [[ -f "$workspaces" ]] && grep -Fxq -- "$workspace" "$workspaces"
}

write_workspace_rules() {
  if [[ ! -s "$workspaces" ]]; then
    rm -f "$rule_file"
    return
  fi

  {
    echo "# Generated by toggle-single-window-full-tile"
    while IFS= read -r workspace; do
      [[ -n "$workspace" ]] || continue
      echo "workspace = $workspace, gapsout:10, gapsin:5"
    done <"$workspaces"
  } >"$rule_file"
}

toggle_current_workspace() {
  local workspace tmp
  workspace="$(active_workspace)"
  tmp="$(mktemp)"

  touch "$workspaces"

  if workspace_enabled "$workspace"; then
    grep -Fxv -- "$workspace" "$workspaces" >"$tmp" || true
    mv "$tmp" "$workspaces"
    notify-send -u low "single-window tiled full off for workspace $workspace"
  else
    grep -Fxv -- "$workspace" "$workspaces" >"$tmp" || true
    printf '%s\n' "$workspace" >>"$tmp"
    mv "$tmp" "$workspaces"
    notify-send -u low "single-window tiled full on for workspace $workspace"
  fi

  write_workspace_rules
  hyprctl reload
}

case "${1:-toggle}" in
  toggle) toggle_current_workspace ;;
  *)
    echo "Usage: $(basename "$0") [toggle]" >&2
    exit 1
    ;;
esac
