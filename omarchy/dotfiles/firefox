#!/bin/sh

set -eu

profiles_ini="$HOME/.config/mozilla/firefox/profiles.ini"
source_user_js="$DOTFILES_DIRECTORY/firefox/.config/mozilla/firefox/user.js"

if [ ! -f "$profiles_ini" ]; then
  echo "skipping firefox (missing: $profiles_ini)" >&2
  return 0
fi

profile_path="$(
  awk '
    $0 == "[Install4F96D1932A9F858E]" { in_install = 1; next }
    /^\[/ { in_install = 0 }
    in_install && /^Default=/ { sub(/^Default=/, ""); print; exit }
  ' "$profiles_ini"
)"

if [ -z "$profile_path" ]; then
  profile_path="$(
    awk '
      /^Path=/ { path = $0; sub(/^Path=/, "", path) }
      /^Default=1$/ && path { print path; exit }
    ' "$profiles_ini"
  )"
fi

if [ -z "$profile_path" ]; then
  echo "skipping firefox (no default profile found)" >&2
  return 0
fi

ln -sf "$source_user_js" "$HOME/.config/mozilla/firefox/$profile_path/user.js"
