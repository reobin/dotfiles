{
  "title": "Swap ISO §± and `~ keys for ANSI positions",
  "rules": [
    {
      "description": "Swap ISO §± and `~ keys for ANSI positions",
      "manipulators": [
        {
          "conditions": [
            {
              "identifiers": [
                {
                  "is_built_in_keyboard": true,
                  "is_keyboard": true
                }
              ],
              "type": "device_if"
            }
          ],
          "from": {
            "key_code": "grave_accent_and_tilde",
            "modifiers": {
              "optional": [
                "any"
              ]
            }
          },
          "to": [
            {
              "key_code": "non_us_backslash"
            }
          ],
          "type": "basic"
        },
        {
          "conditions": [
            {
              "identifiers": [
                {
                  "is_built_in_keyboard": true,
                  "is_keyboard": true
                }
              ],
              "type": "device_if"
            }
          ],
          "from": {
            "key_code": "non_us_backslash",
            "modifiers": {
              "optional": [
                "any"
              ]
            }
          },
          "to": [
            {
              "key_code": "grave_accent_and_tilde"
            }
          ],
          "type": "basic"
        }
      ]
    }
  ]
}
