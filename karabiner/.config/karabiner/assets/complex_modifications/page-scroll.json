{
  "title": "Use alt u and alt d to nudge the scrollback and alt shift u and alt shift d to page",
  "rules": [
    {
      "description": "Use alt u and alt d to nudge the scrollback and alt shift u and alt shift d to page",
      "manipulators": [
        {
          "conditions": [
            {
              "bundle_identifiers": [
                "^com\\.mitchellh\\.ghostty$"
              ],
              "type": "frontmost_application_if"
            }
          ],
          "from": {
            "key_code": "u",
            "modifiers": {
              "mandatory": [
                "option"
              ]
            }
          },
          "to": [
            {
              "mouse_key": {
                "vertical_wheel": -48
              }
            }
          ],
          "type": "basic"
        },
        {
          "conditions": [
            {
              "bundle_identifiers": [
                "^com\\.mitchellh\\.ghostty$"
              ],
              "type": "frontmost_application_if"
            }
          ],
          "from": {
            "key_code": "d",
            "modifiers": {
              "mandatory": [
                "option"
              ]
            }
          },
          "to": [
            {
              "mouse_key": {
                "vertical_wheel": 48
              }
            }
          ],
          "type": "basic"
        },
        {
          "from": {
            "key_code": "u",
            "modifiers": {
              "mandatory": [
                "option",
                "shift"
              ]
            }
          },
          "to": [
            {
              "key_code": "page_up",
              "modifiers": []
            }
          ],
          "type": "basic"
        },
        {
          "from": {
            "key_code": "d",
            "modifiers": {
              "mandatory": [
                "option",
                "shift"
              ]
            }
          },
          "to": [
            {
              "key_code": "page_down",
              "modifiers": []
            }
          ],
          "type": "basic"
        }
      ]
    }
  ]
}
