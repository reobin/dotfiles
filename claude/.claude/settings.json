{
  "env": {
    "DISABLE_ERROR_REPORTING": "1",
    "BROWSER": "none",
    "GH_BROWSER": "open"
  },
  "permissions": {
    "defaultMode": "auto"
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bash '/Users/reobin/.claude/hooks/herdr-agent-state.sh' session",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "bash '/Users/reobin/.claude/statusline.sh'"
  },
  "enabledPlugins": {
    "Notion@claude-plugins-official": true,
    "mattpocock-skills@mattpocock": true,
    "rust-analyzer-lsp@claude-plugins-official": true
  },
  "extraKnownMarketplaces": {
    "mattpocock": {
      "source": {
        "source": "github",
        "repo": "mattpocock/skills"
      }
    }
  },
  "remote": {
    "defaultEnvironmentId": "env_01FEEXG2YVgrSU375srfc8oT"
  },
  "tui": "default",
  "theme": "auto",
  "editorMode": "normal",
  "terminalProgressBarEnabled": true,
  "agentPushNotifEnabled": true,
  "remoteControlEnabled": true,
  "mcpServers": {
    "slack": {
      "type": "http",
      "url": "https://mcp.slack.com/mcp",
      "oauth": {
        "clientId": "1601185624273.8899143856786",
        "callbackPort": 3118
      }
    }
  },
  "remoteControlAtStartup": true
}
