{
  "env": {
    "DISABLE_ERROR_REPORTING": "1",
    "BROWSER": "none",
    "GH_BROWSER": "open",
    "CLAUDE_CODE_NATIVE_CURSOR": "1",
    "FORCE_HYPERLINK": "1",
    "VITEST_MAX_WORKERS": "4",
    "CLAUDE_CODE_PLUGIN_DIRS": "~/dotfiles/claude-mods/tide"
  },
  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  },
  "permissions": {
    "allow": [
      "Bash(gh:*)"
    ],
    "defaultMode": "auto"
  },
  "model": "opus[1m]",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/bin/sh -c 'rex __internal session-start --agent claude --feature-session-naming=false 2>/dev/null || true'",
            "timeout": 5
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "rust-analyzer-lsp@claude-plugins-official": false,
    "cc-plugin-you-should-know@builtin": true
  },
  "outputStyle": "Concise",
  "effortLevel": "high",
  "modelSettings": {
    "claude-opus-5-5": {
      "effortLevel": "high"
    }
  },
  "remote": {
    "defaultEnvironmentId": "env_01FEEXG2YVgrSU375srfc8oT"
  },
  "tui": "fullscreen",
  "autoMemoryEnabled": false,
  "skipWorkflowUsageWarning": true,
  "theme": "auto",
  "editorMode": "normal",
  "verbose": false,
  "terminalProgressBarEnabled": true,
  "remoteControlAtStartup": false,
  "agentPushNotifEnabled": true,
  "remoteControlEnabled": true,
  "mcpServers": {
    "slack": {
      "type": "http",
      "url": "https://mcp.slack.com/mcp",
      "oauth": {
        "clientId": "1601185624273.8899143856786",
        "callbackPort": 3118
      }
    }
  }
}
