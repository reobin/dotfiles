{
  "env": {
    "DISABLE_ERROR_REPORTING": "1",
    "BROWSER": "none",
    "GH_BROWSER": "open",
    "CLAUDE_CODE_NATIVE_CURSOR": "1",
    "FORCE_HYPERLINK": "1",
    "CLAUDE_CODE_PLUGIN_DIRS": "~/dotfiles/claude-mods/tide:~/dotfiles/claude-mods/pr-row"
  },
  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  },
  "permissions": {
    "allow": [
      "Bash(gh:*)",
      "Bash(herdr pane read:*)"
    ],
    "defaultMode": "auto"
  },
  "model": "opus[1m]",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/.claude/hooks/herdr-agent-state.sh\" session",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "^(startup|resume|clear|compact|fork)$",
        "hooks": [
          {
            "type": "command",
            "command": "bash '/Users/reobin/.claude/hooks/herdr-agent-state.sh' session",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "rust-analyzer-lsp@claude-plugins-official": false,
    "cc-plugin-you-should-know@builtin": true
  },
  "outputStyle": "Concise",
  "effortLevel": "high",
  "modelSettings": {
    "claude-opus-5-5": {
      "effortLevel": "medium"
    }
  },
  "remote": {
    "defaultEnvironmentId": "env_01FEEXG2YVgrSU375srfc8oT"
  },
  "tui": "fullscreen",
  "autoMemoryEnabled": false,
  "skipWorkflowUsageWarning": true,
  "theme": "auto",
  "editorMode": "normal",
  "verbose": false,
  "terminalProgressBarEnabled": true,
  "remoteControlAtStartup": true,
  "agentPushNotifEnabled": true,
  "remoteControlEnabled": true,
  "mcpServers": {
    "slack": {
      "type": "http",
      "url": "https://mcp.slack.com/mcp",
      "oauth": {
        "clientId": "1601185624273.8899143856786",
        "callbackPort": 3118
      }
    }
  }
}
