{
  "env": {
    "DISABLE_ERROR_REPORTING": "1",
    "BROWSER": "none",
    "GH_BROWSER": "open",
    "CLAUDE_CODE_NATIVE_CURSOR": "1",
    "FORCE_HYPERLINK": "1",
    "VITEST_MAX_WORKERS": "4",
    "CLAUDE_CODE_PLUGIN_DIRS": "~/dotfiles/claude-mods/tide"
  },
  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  },
  "permissions": {
    "allow": [
      "Bash(gh:*)"
    ],
    "defaultMode": "auto"
  },
  "model": "opus[1m]",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/bin/sh -c 'rex __internal session-start --agent claude --feature-session-naming=false 2>/dev/null || true'",
            "timeout": 5
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ -n \"$HC_TERMINAL_ID\" ] || exit 0; hc get \"$HC_TERMINAL_ID\" 2>/dev/null | jq -r '.labels[\"herdr.space\"] // empty' | { read -r s && herdr-app ls 2>/dev/null | jq -r --arg s \"$s\" '.spaces[] | select(.id == $s and .name == (.folder | rtrimstr(\"/\") | split(\"/\") | last)) | \"Name your Herdr space after this prompt, without mentioning it: herdr-app do space.rename --id \\(.id) --name <label>\"'; }; exit 0",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "AskUserQuestion",
        "hooks": [
          {
            "type": "command",
            "command": "t=$(ps -o tty= -p $PPID | tr -d ' '); case $t in ''|'??') exit 0;; esac; printf '\\033[4 q' > /dev/$t 2>/dev/null; exit 0",
            "timeout": 5
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "rust-analyzer-lsp@claude-plugins-official": false,
    "cc-plugin-you-should-know@builtin": true
  },
  "outputStyle": "Concise",
  "effortLevel": "high",
  "modelSettings": {
    "claude-opus-5-5": {
      "effortLevel": "high"
    }
  },
  "remote": {
    "defaultEnvironmentId": "env_01FEEXG2YVgrSU375srfc8oT"
  },
  "tui": "fullscreen",
  "autoMemoryEnabled": false,
  "skipWorkflowUsageWarning": true,
  "theme": "auto",
  "editorMode": "normal",
  "verbose": false,
  "terminalProgressBarEnabled": true,
  "remoteControlAtStartup": false,
  "agentPushNotifEnabled": true,
  "remoteControlEnabled": true
}
