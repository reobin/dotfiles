[alias]
  ca = commit --amend --no-edit
  p = push
  pf = push --force-with-lease
  pl = pull
  cp = cherry-pick
  f = fetch
  r = rebase
  rt = reset
  rts = reset --soft
  rth = reset --hard
  ri = "!f() { git rebase -i HEAD~$1; }; f"
  rir = rebase -i --root
  c = commit
  b = branch
  co = checkout
  a = add .
  s = status
  sh = stash
  shp = stash pop
  shd = stash drop
  l = log
  d = diff
  bc = !"$HOME/.config/git/scripts/branch-cleanup"
[core]
	editor = nvim
	pager = delta
	untrackedCache = true    # Cache untracked files so status skips the tree walk
[sequence]
	editor = nvim
[init]
	defaultBranch = main
[pull]
	rebase = true 			 # Rebase (instead of merge) on pull
[push]
	autoSetupRemote = true   # Automatically set upstream branch on push
[rebase]
	updateRefs = true        # Keep stacked branches attached when rebasing below them
	autosquash = true        # Order fixups from `ca` automatically
	autostash = true         # Let `pull.rebase` work on a dirty tree
[fetch]
	prune = true             # Drop remote-tracking refs that are gone
[pager]
	diff = hunk pager        # Review `git diff` in hunk; delta keeps log and show
[diff]
	algorithm = histogram    # Clearer diffs on moved/edited lines
	colorMoved = plain       # Highlight moved blocks in diffs
	colorMovedWS = allow-indentation-change   # Moved-and-reindented is still a move
	mnemonicPrefix = true    # More intuitive refs in diff output
	tool = nvimdiff
[interactive]
	diffFilter = delta --color-only   # Keep delta's colors in `add -p`
[commit]
	verbose = true           # Include diff comment in commit message template
	gpgsign = true
[column]
	ui = auto 			     # Output in columns when possible
[branch]
	sort = -committerdate    # Sort branches by most recent commit first
[tag]
	sort = -version:refname  # Sort version numbers as you would expect
[rerere]
	enabled = true           # Record and reuse conflict resolutions
	autoupdate = true        # Apply stored conflict resolutions automatically
[user]
	name = Robin Gagnon
	email = me@reobin.dev
	signingkey = ~/.ssh/id_ed25519.pub
[gpg]
	format = ssh
[gpg "ssh"]
	allowedSignersFile = ~/.config/git/allowed_signers
[wt]
	basedir = ../{gitroot}-wt
	copyignored = true
	copyuntracked = true
	copymodified = true
	nocopy = node_modules/
	hook = mise trust .
[credential]
	helper = osxkeychain
[merge]
	tool = nvimdiff
