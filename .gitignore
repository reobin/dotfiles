claude/.claude/*
!claude/.claude/keybindings.json
!claude/.claude/settings.json
!claude/.claude/statusline.sh
# No hook stays in this repo. settings.json points PreToolUse at
# ~/.claude/hooks/local-guard.sh, which dispatches to whatever machine-local
# policies exist and exits quietly where there are none. The policies
# themselves are private, so this repo carries the wiring and nothing else.
claude/.claude/hooks/
herdr/.config/herdr/config.toml
herdr/.config/herdr/config.toml.tmp.*
herdr/.config/herdr/herdr-client.log
herdr/.config/herdr/herdr-server.log
herdr/.config/herdr/session.json
herdr/.config/herdr/release-notes.json
herdr/.config/herdr/.plugins.lock
herdr/.config/herdr/plugins.json
herdr/.config/herdr/plugins/
herdr/.local/bin/bunx
herdr/.local/bin/claude
herdr/.local/bin/herdr
herdr/.local/bin/analyze-traffic-conditions
herdr/.local/bin/feature-callout-implementer
herdr/.local/bin/interpret-load-test-results
herdr/.local/bin/plan-load-test
herdr/.local/bin/pr-dashboard
herdr/.local/bin/slackcli
opencode/.config/opencode/plugins/herdr-agent-state.js
opencode/.config/opencode/AGENTS.md
opencode/.config/opencode/commands/
opencode/.config/opencode/skills/
tt/.config/ghostty/themes/terminal-active
