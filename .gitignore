# ~/.local/bin is a stow link into this directory, and this repo is public, so
# anything installed there has to be ignored by default rather than named.
herdr/.local/bin/*
!herdr/.local/bin/herdr-*
herdr/.local/bin/herdr-reviewr
opencode/.config/opencode/plugins/herdr-agent-state.js
opencode/.config/opencode/herdr-tui-session.js
