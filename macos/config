#!/usr/bin/env bash

set -eu

# Keep this Mac awake while plugged in. Lid-closed sleep is blocked by the
# com.reobin.keep-awake daemon under macos/daemons/, since `pmset disablesleep`
# has no per-power-source form.

# Disable the accented character popup when holding a key.
defaults write -g ApplePressAndHoldEnabled -bool false

# Make key repeat feel faster.
defaults write -g InitialKeyRepeat -int 20
defaults write -g KeyRepeat -int 1

# Make Dock autohide feel instant.
defaults write com.apple.dock autohide-time-modifier -int 0
defaults write com.apple.Dock autohide-delay -float 0.0001
killall Dock

# Show every file extension, and the full path in Finder window footers.
defaults write -g AppleShowAllExtensions -bool true
defaults write com.apple.finder ShowPathbar -bool true
killall Finder || true

# Keep screenshots and Cmd-Shift-5 recordings off the Desktop.
SCREENSHOT_DIRECTORY="$HOME/Pictures/Screenshots"
mkdir -p "$SCREENSHOT_DIRECTORY"
defaults write com.apple.screencapture location "$SCREENSHOT_DIRECTORY"
killall SystemUIServer || true

# Keep the machine awake on AC power, but still let the displays blank on
# idle (~15 min). This only covers idle sleep; the keep-awake daemon owns the
# lid. Battery power keeps a normal sleep timeout after the display blanks.
sudo pmset -c sleep 0
sudo pmset -b sleep 20
sudo pmset -a displaysleep 15
sudo pmset -a powernap 0
sudo pmset -a tcpkeepalive 1
sudo pmset -c standby 0
sudo pmset -c womp 1
