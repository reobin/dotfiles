#!/usr/bin/env bash

# stow folds ~/.config/opencode into a symlink pointing back at this repo, so
# an unguarded rm through that path deletes tracked sources. Only clear real
# unmanaged files, left behind by opencode's own json config.
if [[ ! -L ~/.config/opencode ]]; then
  rm -f ~/.config/opencode/opencode.json
  rm -f ~/.config/opencode/tui.json
fi

stow opencode
