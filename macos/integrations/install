#!/usr/bin/env bash

set -eu

if ! command -v herdr >/dev/null 2>&1; then
  echo "Skipping Herdr integrations (herdr is not installed)" >&2
  return 0
fi

SPACE_TOKENS_ID="reobin.space-tokens"
SPACE_TOKENS_DIR="$DOTFILES_DIRECTORY/herdr/.config/herdr/space-tokens"

# Stowing the plugin is not enough. Herdr only loads a local plugin once it is
# linked, and that link lives in the gitignored plugins.json.
#
# Herdr's output is captured rather than piped into grep: `grep -q` closes the
# pipe on its first match, and herdr panics on the broken pipe.
if grep -q "$SPACE_TOKENS_ID" <<<"$(herdr plugin list)"; then
  echo "Herdr $SPACE_TOKENS_ID plugin is already linked"
else
  echo "linking Herdr $SPACE_TOKENS_ID plugin"
  herdr plugin link "$SPACE_TOKENS_DIR"
fi

HUNKDIFF_ID="jhochenbaum.hunkdiff"

install_herdr_plugin() {
  local plugin_id="$1" plugin_repo="$2"

  if grep -q "$plugin_id" <<<"$(herdr plugin list)"; then
    echo "Herdr $plugin_id plugin is already installed"
    return 0
  fi

  echo "installing Herdr $plugin_id plugin"
  herdr plugin install "$plugin_repo" --yes
}

# hunkdiff builds with npm and runs every action, event and pane through node.
if command -v node >/dev/null 2>&1; then
  install_herdr_plugin "$HUNKDIFF_ID" jhochenbaum/herdr-hunk-diff
else
  echo "Skipping Herdr $HUNKDIFF_ID plugin (node is not installed)" >&2
fi

install_herdr_plugin reobin.close-other-panes reobin/herdr-close-other-panes

unset -f install_herdr_plugin

HUNK_SHIM="${XDG_DATA_HOME:-$HOME/.local/share}/mise/shims/hunk"

# Left alone, the plugin runs a hunkdiff it bundles, which trails the one mise
# manages and the git pager and review skill drive. The shim is the stable path
# to that one; mise's install paths carry the version and dangle on upgrade.
if ! grep -q "$HUNKDIFF_ID" <<<"$(herdr plugin list)"; then
  echo "Skipping Herdr $HUNKDIFF_ID config ($HUNKDIFF_ID is not installed)" >&2
elif [[ ! -x "$HUNK_SHIM" ]]; then
  echo "Skipping Herdr $HUNKDIFF_ID config (missing: $HUNK_SHIM)" >&2
else
  HUNKDIFF_CONFIG_DIR="$(herdr plugin config-dir "$HUNKDIFF_ID")"
  mkdir -p "$HUNKDIFF_CONFIG_DIR"

  cat >"$HUNKDIFF_CONFIG_DIR/config.toml" <<EOF
# written by macos/integrations/install
[review]
default_target = "working"

[hunk]
bin = "$HUNK_SHIM"
EOF

  echo "pinned Herdr $HUNKDIFF_ID to $HUNK_SHIM"
fi

INTEGRATION_STATUS="$(herdr integration status)"

# Each agent reports its state through a hook written into that agent's own
# config directory, so every agent needs its own install.
install_herdr_integration() {
  local integration="$1"
  shift

  local bin
  for bin in "$@"; do
    if ! command -v "$bin" >/dev/null 2>&1; then
      continue
    fi

    if grep -q "^$integration: current" <<<"$INTEGRATION_STATUS"; then
      echo "Herdr $integration integration is already installed"
    else
      echo "installing Herdr $integration integration"
      herdr integration install "$integration"
    fi

    return 0
  done

  local names
  names="$(
    IFS=/
    echo "$*"
  )"

  echo "Skipping Herdr $integration integration ($names is not installed)" >&2
}

# opencode ships the `opencode` command, opencode-vim ships `ocv`.
install_herdr_integration opencode opencode ocv
install_herdr_integration claude claude
install_herdr_integration codex codex

unset -f install_herdr_integration

herdr server reload-config >/dev/null 2>&1 || true
