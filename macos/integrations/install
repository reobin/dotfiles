#!/usr/bin/env bash

set -eu

if ! command -v herdr >/dev/null 2>&1; then
  echo "Skipping Herdr integrations (herdr is not installed)" >&2
  return 0
fi

SPACE_TOKENS_ID="reobin.space-tokens"
SPACE_TOKENS_DIR="$DOTFILES_DIRECTORY/herdr/.config/herdr/space-tokens"

# Stowing the plugin is not enough. Herdr only loads a local plugin once it is
# linked, and that link lives in the gitignored plugins.json.
#
# Herdr's output is captured rather than piped into grep: `grep -q` closes the
# pipe on its first match, and herdr panics on the broken pipe.
if grep -q "$SPACE_TOKENS_ID" <<<"$(herdr plugin list)"; then
  echo "Herdr $SPACE_TOKENS_ID plugin is already linked"
else
  echo "linking Herdr $SPACE_TOKENS_ID plugin"
  herdr plugin link "$SPACE_TOKENS_DIR"
fi

REVIEWR_ID="persiyanov.reviewr"

install_herdr_plugin() {
  local plugin_id="$1" plugin_repo="$2"

  if grep -q "$plugin_id" <<<"$(herdr plugin list)"; then
    echo "Herdr $plugin_id plugin is already installed"
    return 0
  fi

  echo "installing Herdr $plugin_id plugin"
  herdr plugin install "$plugin_repo" --yes
}

install_herdr_plugin reobin.close-other-panes reobin/herdr-close-other-panes
install_herdr_plugin to4iki.unread-jump to4iki/herdr-unread-jump
install_herdr_plugin herdr-arrange crierr/herdr-arrange
install_herdr_plugin "$REVIEWR_ID" persiyanov/herdr-reviewr

unset -f install_herdr_plugin

# reviewr ships prebuilt binaries, so it needs no toolchain and no node. Left
# alone it opens itself in every worktree workspace.
if ! grep -q "$REVIEWR_ID" <<<"$(herdr plugin list)"; then
  echo "Skipping Herdr $REVIEWR_ID config ($REVIEWR_ID is not installed)" >&2
else
  REVIEWR_CONFIG_DIR="$(herdr plugin config-dir "$REVIEWR_ID")"
  mkdir -p "$REVIEWR_CONFIG_DIR"

  # tt owns the `theme` key; keep whatever it (or the user) set so a re-run of
  # ./macos/init never drops reviewr back to its dark default.
  REVIEWR_THEME="$(grep -E '^theme[[:space:]]*=' "$REVIEWR_CONFIG_DIR/config.toml" 2>/dev/null | tail -1 || true)"

  cat >"$REVIEWR_CONFIG_DIR/config.toml" <<EOF
# written by macos/integrations/install
auto_open = false
navigator_position = "left"
EOF

  if [[ -n "$REVIEWR_THEME" ]]; then
    printf '%s\n' "$REVIEWR_THEME" >>"$REVIEWR_CONFIG_DIR/config.toml"
  fi

  echo "configured Herdr $REVIEWR_ID"
fi

INTEGRATION_STATUS="$(herdr integration status)"

# Each agent reports its state through a hook written into that agent's own
# config directory, so every agent needs its own install.
install_herdr_integration() {
  local integration="$1"
  shift

  local bin
  for bin in "$@"; do
    if ! command -v "$bin" >/dev/null 2>&1; then
      continue
    fi

    if grep -q "^$integration: current" <<<"$INTEGRATION_STATUS"; then
      echo "Herdr $integration integration is already installed"
    else
      echo "installing Herdr $integration integration"
      herdr integration install "$integration"
    fi

    return 0
  done

  local names
  names="$(
    IFS=/
    echo "$*"
  )"

  echo "Skipping Herdr $integration integration ($names is not installed)" >&2
}

install_herdr_integration opencode opencode
install_herdr_integration claude claude
install_herdr_integration codex codex

unset -f install_herdr_integration

# herdr owns tui.jsonc, so scroll keys merge here instead of git.
OPENCODE_TUI_JSONC="$HOME/.config/opencode/tui.jsonc"
if command -v python3 >/dev/null 2>&1; then
  mkdir -p "$(dirname "$OPENCODE_TUI_JSONC")"
  python3 - "$OPENCODE_TUI_JSONC" <<'EOF'
import json, sys

path = sys.argv[1]
try:
    data = json.load(open(path))
except FileNotFoundError:
    data = {}
except json.JSONDecodeError as e:
    print(f"warning: skipping opencode scroll-key merge ({e})", file=sys.stderr)
    sys.exit(0)

if not isinstance(data, dict):
    data = {}
if not isinstance(data.get("keybinds"), dict):
    data["keybinds"] = {}
keybinds = data["keybinds"]

changed = False
wanted = {
    "messages_half_page_up": ("ctrl+alt+u", "ctrl+u"),
    "messages_half_page_down": ("ctrl+alt+d", "ctrl+d"),
    "messages_first": ("alt+shift+u",),
    "messages_last": ("alt+shift+d",),
}
for action, bindings in wanted.items():
    current = keybinds.get(action, "")
    if not isinstance(current, str):
        current = ""
    parts = [p.strip() for p in current.split(",") if p.strip()]
    for b in bindings:
        if b not in parts:
            parts.append(b)
            changed = True
    keybinds[action] = ",".join(parts)

# alt+shift+d now jumps to the last message, and alt+d scrolls half a
# page, so neither can stay on word-forward. Fall back to the
# conflict-free defaults when nothing else remains.
current = keybinds.get("input_delete_word_forward", "")
if not isinstance(current, str):
    current = ""
parts = [p.strip() for p in current.split(",") if p.strip()]
if not parts:
    parts = ["alt+d", "alt+delete", "ctrl+delete"]
kept = [p for p in parts if p not in ("alt+d", "alt+shift+d")]
if not kept:
    kept = ["alt+delete", "ctrl+delete"]
if ",".join(kept) != current:
    keybinds["input_delete_word_forward"] = ",".join(kept)
    changed = True

if changed:
    with open(path, "w") as f:
        json.dump(data, f, indent=2)
        f.write("\n")
    print("merged opencode scroll keys into tui.jsonc")
EOF
fi

herdr server reload-config >/dev/null 2>&1 || true
