#!/usr/bin/env bash

if command -v ocv >/dev/null 2>&1 && ocv --version >/dev/null 2>&1; then
  echo "ocv is already installed"
  return 0
fi

npm install -g @leohenon/ocv@latest

npm_prefix="$(npm config get prefix)"
if [[ ! -x "$npm_prefix/lib/node_modules/@leohenon/ocv/bin/.ocv" ]]; then
  echo "ocv native binary is missing after install" >&2
  return 1
fi

"$npm_prefix/bin/ocv" --version >/dev/null
