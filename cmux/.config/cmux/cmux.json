{
  "$schema": "https://raw.githubusercontent.com/manaflow-ai/cmux/main/web/data/cmux.schema.json",
  "schemaVersion": 1,

  // Herdr's key map, ported. cmux nests one level differently: a workspace holds
  // panes and a pane holds surfaces, where Herdr's workspace holds tabs and a tab
  // holds panes. Surfaces are what the tab bar shows, so Herdr's tab bindings land
  // on surfaces and its pane bindings on panes.
  //
  // Everything not listed keeps its cmux default, so the mac-standard chords
  // (cmd+, cmd+w, cmd+1..9 for workspaces) still work.
  //
  // Terminal appearance and terminal-level keys come from ~/.config/ghostty/config,
  // which cmux reads directly.
  "shortcuts": {
    "bindings": {
      "openSettings": ["ctrl+space", "shift+s"],
      "reloadConfiguration": ["ctrl+space", "shift+r"],

      "goToWorkspace": ["ctrl+space", "w"],
      "newTab": ["ctrl+space", "shift+c"],
      "renameWorkspace": ["ctrl+space", "shift+w"],
      "closeWorkspace": ["ctrl+space", "shift+q"],

      // Workspaces are the left sidebar's tabs, so their next/prev actions are
      // named for the sidebar rather than for the workspace.
      "prevSidebarTab": "alt+k",
      "nextSidebarTab": "alt+j",
      "moveWorkspaceUp": "alt+shift+k",
      "moveWorkspaceDown": "alt+shift+j",

      "newSurface": ["ctrl+space", "c"],
      "renameTab": ["ctrl+space", "shift+t"],
      "closeTab": ["ctrl+space", "q"],
      "prevSurface": "alt+h",
      "nextSurface": "alt+l",
      "moveSurfaceLeft": "alt+shift+h",
      "moveSurfaceRight": "alt+shift+l",

      // A single binding stands for the whole 1..9 row.
      "selectSurfaceByNumber": "alt+1",

      "focusLeft": ["ctrl+space", "h"],
      "focusDown": ["ctrl+space", "j"],
      "focusUp": ["ctrl+space", "k"],
      "focusRight": ["ctrl+space", "l"],

      // Nothing swaps two panes in place. Moving the focused surface to the
      // neighbouring pane is the closest thing prefix+shift+hjkl can do.
      "moveSurfaceToPaneLeft": ["ctrl+space", "shift+h"],
      "moveSurfaceToPaneDown": ["ctrl+space", "shift+j"],
      "moveSurfaceToPaneUp": ["ctrl+space", "shift+k"],
      "moveSurfaceToPaneRight": ["ctrl+space", "shift+l"],

      "splitRight": ["ctrl+space", "v"],
      "splitDown": ["ctrl+space", "s"],
      "toggleSplitZoom": ["ctrl+space", "f"],

      // There is no resize mode and no per-edge resize action, so prefix+r
      // evens the splits out instead of entering one.
      "equalizeSplits": ["ctrl+space", "r"],

      "closeOtherTabsInPane": ["ctrl+space", "o"],

      // Herdr's scrollback editor has no counterpart; copy mode is the way to
      // get at what scrolled past.
      "toggleTerminalCopyMode": ["ctrl+space", "e"],

      // Built in, so no hunkdiff and no unread-jump plugin needed.
      "openDiffViewer": "alt+r",
      "jumpToUnread": "alt+n"
    }
  }
}
